# The mobile app reads match data directly from FotMob.
# No API server URL or database credentials are needed to display matches.

# Mobile API reachable over the local network (optional).
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000

# Firebase (Auth + Firestore) — used for everything that concerns the user
# (profile, favorites, basket, saved selections, combinations, plan, prefs).
# Fill in with the values from the Firebase console:
# Console Firebase > Project settings > Your apps > SDK setup and configuration
# These are public client-side keys, not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
